{
  "name": "bob-work",
  "version": "0.7.680",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "lint:build": "eslint . --quiet",
    "lint:style": "stylelint \"src/**/*.css\"",
    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "pnpm dlx concurrently --group --names lint-tsc,lint-build,lint-style \"pnpm ts-check\" \"pnpm lint:build\" \"pnpm lint:style\"",
    "dev:web": "PORT=3000 pnpm tsx watch src/server.ts",
    "dev:8321": "next dev -H :: --port 8321",
    "compile:electron": "tsup electron/main.ts electron/preload.ts --format cjs --platform node --target node20 --outDir electron/dist --no-splitting --external electron && mkdir -p electron/dist/pdf/core electron/dist/swift && cp src/lib/pdf/core/ocr_vision.swift electron/dist/pdf/core/ocr_vision.swift && cp src/lib/screen-ocr/screen_permission.swift electron/dist/swift/screen_permission.swift && bash ../screenshot-plugin/build-helper.sh",
    "dev:electron": "pnpm compile:electron && electron .",
    "build:next": "next build",
    "build:desktop": "bash ./scripts/build-electron.sh",
    "package:release": "bash ./scripts/package-release.sh",
    "package:release:arm64": "bash ./scripts/package-release.sh arm64"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ktrysmt/beautiful-mermaid": "^1.5.2",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.29.2",
    "@tiptap/extension-heading": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "coze-coding-dev-sdk": "^0.7.24",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "next": "16.1.1",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^2.6.0",
    "tiptap-markdown": "^0.9.0",
    "tiptap-track-changes": "^0.2.1",
    "tsdav": "^2.3.1",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "unified-renderer": "file:../assets/unified-renderer",
    "utif2": "^4.1.0",
    "ws": "^8.21.2",
    "xlsx": "^0.18.5",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@playwright/test": "^1.62.1",
    "@react-dev-inspector/babel-plugin": "^2.0.1",
    "@react-dev-inspector/middleware": "^2.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "only-allow": "^1.2.2",
    "postcss": "^8.5.24",
    "react-dev-inspector": "^2.0.1",
    "shadcn": "latest",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "build": {
    "appId": "com.bobwork.app",
    "productName": "BobWork",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next-standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "next-standalone/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "next-standalone/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://gitcode.com/baolei89/BobWork/releases/download/latest"
      }
    ]
  }
}