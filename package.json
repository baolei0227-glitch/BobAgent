  "scripts": {
    "build": "bash ./scripts/build.sh",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "lint:build": "eslint . --quiet",
    "lint:style": "stylelint \"src/**/*.css\"",
    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "pnpm dlx concurrently --group --names lint-tsc,lint-build,lint-style \"pnpm ts-check\" \"pnpm lint:build\" \"pnpm lint:style\"",
    "dev:web": "PORT=3000 pnpm tsx watch src/server.ts",
    "dev:8321": "next dev -H :: --port 8321",
    "compile:electron": "tsup electron/main.ts electron/preload.ts --format cjs --platform node --target node20 --outDir electron/dist --no-splitting --external electron && mkdir -p electron/dist/pdf/core electron/dist/swift && cp src/lib/pdf/core/ocr_vision.swift electron/dist/pdf/core/ocr_vision.swift && cp src/lib/screen-ocr/screen_permission.swift electron/dist/swift/screen_permission.swift && bash ../screenshot-plugin/build-helper.sh",
    "dev:electron": "pnpm compile:electron && electron .",
    "build:next": "next build",
    "build:desktop": "bash ./scripts/build-electron.sh",
    "package:release": "bash ./scripts/package-release.sh",
    "package:release:arm64": "bash ./scripts/package-release.sh arm64"
  },
